{
  "name": "neon-city-agents",
  "private": true,
  "version": "1.0.0",
  "description": "Your AI agents live in a rain-soaked neon city: drive to their buildings and read their terminals. A fork of Neon Zenith (three.js WebGPU + TSL).",
  "license": "MIT",
  "author": "Neon City Agents contributors; based on Neon Zenith by Bill Chan (https://github.com/billpwchan)",
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "agent-dashboard",
    "threejs",
    "webgpu",
    "tsl",
    "cyberpunk",
    "hong-kong",
    "procedural-city",
    "game",
    "flying-car",
    "blender"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:nomock": "node scripts/dev.mjs --no-mock",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:web": "vite --host 127.0.0.1 --port 5200",
    "server": "node server/index.mjs",
    "server:mock": "node server/index.mjs --mock",
    "mock": "node server/mock.mjs",
    "test": "node --test server/*.test.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5201",
    "start": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/neonderthaw": "^5.3.0",
    "@fontsource/noto-serif-tc": "^5.3.0",
    "@fontsource/tilt-neon": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "gl-matrix": "^3.4.4",
    "iwer": "2.5.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.2"
  }
}
